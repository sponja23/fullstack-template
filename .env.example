# Backend / API
DATABASE_URL=postgres://user:password@localhost:5435/acme
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
WEB_URL=http://localhost:5173
PORT=3000

# Hosts better-auth trusts when deriving its base URL from the request Host header.
# AUTH_TRUSTED_HOSTS=localhost:3000
# Registrable domain for cross-subdomain session cookies. Leave unset for local HTTP.
# AUTH_COOKIE_DOMAIN=.example.com

# Frontend
VITE_API_URL=http://localhost:3000

# Opt in to local trace export with `pnpm telemetry:up`.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

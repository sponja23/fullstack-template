msg_file="$1"
subject=$(head -n 1 "$msg_file")

if grep -qi '^co-authored-by:' "$msg_file"; then
    echo "commit-msg: drop the Co-Authored-By trailer" >&2
    exit 1
fi

case "$subject" in
    Merge\ * | Revert\ * | fixup!\ * | squash!\ * | amend!\ *) exit 0 ;;
esac

if ! printf '%s\n' "$subject" | grep -Eq '^(feat|fix|docs|refactor|test|perf|build|ci|chore|revert)(\([^)]+\))?!?: [^A-Z]' ||
    printf '%s\n' "$subject" | grep -q '\.$'; then
    echo "commit-msg: \"$subject\" is not a Conventional Commits subject (type(scope): lowercase summary, no trailing period)" >&2
    exit 1
fi
